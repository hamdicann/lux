# ============================================================
# LUX — Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- Model Configuration ---
LUX_CHAT_MODEL=phi-3.5-mini
LUX_EMBEDDING_MODEL=qwen3-embedding-0.6b

# --- Paths ---
LUX_DATABASE_PATH=data/lux.db
LUX_DOCUMENT_PATH=documents/
LUX_LOG_PATH=data/lux.log

# --- Chunking ---
LUX_CHUNK_SIZE=800
LUX_CHUNK_OVERLAP=120

# --- Retrieval ---
LUX_TOP_K=3
LUX_MIN_SIMILARITY=0.35
LUX_MAX_CONTEXT_CHARS=4000

# --- Generation ---
LUX_TEMPERATURE=0.2
LUX_MAX_TOKENS=1024

# --- Conversation ---
LUX_MAX_CONVERSATION_TURNS=10

# --- Server ---
LUX_HOST=127.0.0.1
LUX_PORT=8000

# --- Debug ---
LUX_DEBUG=false
LUX_LOG_LEVEL=INFO
